      "name": "01 - Cadastrar pergunta de exemplo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/perguntas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enunciado\": \"A tecnologia nuclear possui aplicacoes na medicina.\",\n  \"resposta\": \"V\",\n  \"explicacao\": \"O kickoff apresenta medicina nuclear e producao de radiofarmacos entre as aplicacoes da tecnologia nuclear.\",\n  \"referencia\": \"AMAZUL - Kick-off FIAP - 13OUT26.pdf, p. 34\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Criou\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"perguntaId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
