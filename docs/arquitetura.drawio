        <!-- Legenda do fluxo -->
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF9933;align=left;spacingLeft=10;fontSize=11;" value="&lt;b&gt;Fluxo de automação (IaC)&lt;/b&gt;&lt;br&gt;1. deploy-infra.sh: az group create, az vm create, az vm open-port&lt;br&gt;2. setup-app.sh (na VM): apt install docker.io, docker build, docker run&lt;br&gt;3. cleanup.sh: az group delete + az group show (comprovação)" vertex="1">
